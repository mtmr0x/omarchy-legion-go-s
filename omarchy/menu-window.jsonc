  // >>> legion-nav >>>
  // Window actions, reachable from the gamepad: RT opens this menu.
  // Navigate with the D-pad, choose with Y, back out with LT.
  "window": {"icon": "", "label": "Window", "aliases": ["win"]},
  "window.close": {"icon": "󰭌", "label": "Close window", "action": "hyprctl dispatch killactive"},
  "window.fullscreen": {"icon": "", "label": "Fullscreen", "action": "hyprctl dispatch fullscreen 0"},
  "window.float": {"icon": "", "label": "Float / tile", "action": "hyprctl dispatch togglefloating"},
  "window.next": {"icon": "", "label": "Next workspace", "action": "hyprctl dispatch workspace e+1"},
  "window.prev": {"icon": "", "label": "Previous workspace", "action": "hyprctl dispatch workspace e-1"},
  "window.movenext": {"icon": "󰉉", "label": "Send to next workspace", "action": "hyprctl dispatch movetoworkspace e+1"},
  "window.moveprev": {"icon": "󰉉", "label": "Send to prev workspace", "action": "hyprctl dispatch movetoworkspace e-1"},
  "window.keyboard": {"icon": "", "label": "On-screen keyboard", "action": "legion-osk toggle"},
  "window.gamepad": {"icon": "󰧑", "label": "Gamepad off (game mode)", "action": "legion-nav off"},
  "window.configure": {"icon": "󰧑", "label": "Configure gamepad", "action": "omarchy-launch-tui legion-config"},
  "window.lock": {"icon": "", "label": "Lock", "action": "omarchy-system-lock"},
  "window.power": {"icon": "", "label": "Power", "target": "system"},
  // <<< legion-nav <<<
